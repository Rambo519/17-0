# Postgres connection string.
# Supabase: Project Settings -> Database -> Connection string -> URI
# Local docker: postgres://postgres:postgres@localhost:5432/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Required for `npm run data:import` / `npm run data:refresh` when DATABASE_URL
# is set. Those commands wipe game sessions, picks, players, franchises, eras,
# and related tables before reloading historical data.
# Local PGlite (no DATABASE_URL) does not need this flag.
# ALLOW_DESTRUCTIVE_DATA_IMPORT=1
